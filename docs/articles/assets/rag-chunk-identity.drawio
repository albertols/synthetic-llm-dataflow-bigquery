<mxfile host="app.diagrams.net">
  <diagram id="RagChunkIdentity" name="RagChunkIdentity">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="900" as="geometry"/></mxCell>
        <mxCell id="t1" value="Two chunk types for two problems: a document chunk is text with a label; a structured chunk is an address — and every cache in this pipeline is keyed by one" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="10" width="1400" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="left = apache_beam.ml.rag types as of Beam 2.76 (defaults) · right = sdfb_core.rag.chunking.Chunk · no measured numbers in this figure" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="36" width="1400" height="20" as="geometry"/></mxCell>
        <mxCell id="f3" value="Document RAG — apache_beam.ml.rag.types.Chunk (= EmbeddableItem)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#eb6834;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#b44f26;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="68" width="700" height="330" as="geometry"/></mxCell>
        <mxCell id="m4" value="" style="shape=image;html=1;imageAspect=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="24" height="30" as="geometry"/></mxCell>
        <mxCell id="b5" value="id &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= str(uuid.uuid4()) &amp;nbsp;&amp;nbsp;← default; pass chunk_id_fn to override&lt;br&gt;index &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 0&lt;br&gt;content &amp;nbsp;&amp;nbsp;= Content(text=…, image=…)&lt;br&gt;metadata &amp;nbsp;= { free-form dict }&lt;br&gt;embedding = Embedding(dense_embedding=[…], sparse_embedding=…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="46" y="100" width="668" height="104" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;built for&lt;/b&gt; — split documents (LangChainChunker wraps a TextSplitter) → embed under MLTransform (sentence-transformers or Vertex AI) → write to a vector store (BigQuery, AlloyDB, Postgres, Spanner, Milvus, Qdrant …) → enrich each element of a PCollection with VECTOR_SEARCH or Milvus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;strokeWidth=1.3;fontColor=#7a3217;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="216" width="668" height="76" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;the right shape when&lt;/b&gt; — the corpus is prose, ingestion is continuous, the store is a managed service, and every element of the stream needs its own neighbours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f6ee;strokeColor=#1baf7a;strokeWidth=1.3;fontColor=#0d4a34;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="304" width="668" height="56" as="geometry"/></mxCell>
        <mxCell id="t8" value="a random id is fine there: the store is the source of truth, and nobody needs to recompute it" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5f6368;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="46" y="366" width="668" height="22" as="geometry"/></mxCell>
        <mxCell id="f9" value="Structured RAG — sdfb_core.rag.chunking.Chunk (one rag_chunks row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1baf7a;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#127a55;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="770" y="68" width="700" height="330" as="geometry"/></mxCell>
        <mxCell id="b10" value="chunk_id &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= blake2b(source_fqn : row_digest : index)&lt;br&gt;row_digest &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= sha256(canonical JSON of the row | {column, value})&lt;br&gt;reference_digest = sha256(canonical JSON of the whole sample)&lt;br&gt;chunk_kind &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= row_doc | free_text_col&lt;br&gt;chunk_text &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= serialize_row(row) — the SAME function the engine embeds with | the value&lt;br&gt;embedder_id, embedder_version &amp;nbsp;→ pins the vector space&lt;br&gt;source_pk &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= JSON | NULL &amp;nbsp;&amp;nbsp;&amp;nbsp;embedding = 384 × FLOAT64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="786" y="100" width="668" height="136" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;built for&lt;/b&gt; — a bounded, digest-pinned sample of TABLE ROWS, embedded once, read back by any later run of the same sample, queried in-process a handful of times inside DoFn.setup()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f6ee;strokeColor=#1baf7a;strokeWidth=1.3;fontColor=#0d4a34;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="786" y="248" width="668" height="60" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b&gt;why not the package&lt;/b&gt; — no row serializer · its embedding handlers take a model_name (no GCS→local staging, nothing pins offline) or call Vertex AI · its read side is per-element enrichment against a remote store · importing it would pull apache_beam into the engine layer (ADR 0017)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="786" y="318" width="668" height="70" as="geometry"/></mxCell>
        <mxCell id="t13" value="What byte identity buys — four caches, zero coordination" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="414" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="b14" value="♻️ reuse, not re-embed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="446" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="b15" value="compute_row_digest(row) on the worker == row_digest in rag_chunks ⇒ the stored vector IS this row&#x27;s vector. All-or-nothing over the 1,024-row prefix, dimension checked — in Generate engines today." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="480" width="340" height="96" as="geometry"/></mxCell>
        <mxCell id="b16" value="🔁 retries are idempotent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="402" y="446" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="b17" value="A retried Beam bundle re-chunks the same rows and gets the same chunk_ids — a duplicate is detectable as one, not a new row with a new name." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="402" y="480" width="340" height="96" as="geometry"/></mxCell>
        <mxCell id="b18" value="📌 one vector space per key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="758" y="446" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="b19" value="embedder id + version are part of every read. A new embedder is a new space and a cold run; vectors from two models are never mixed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="758" y="480" width="340" height="96" as="geometry"/></mxCell>
        <mxCell id="b20" value="⚡ same seeds ⇒ same prompt bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1.3;fontColor=#ffffff;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1114" y="446" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="b21" value="Exact search, seeds picked once per column, prompt built once ⇒ byte-identical on every ladder round ⇒ vLLM&#x27;s prefix cache serves rounds 2…k; only the sampling parameters change." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1114" y="480" width="340" height="96" as="geometry"/></mxCell>
        <mxCell id="f22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa0a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="598" width="1440" height="236" as="geometry"/></mxCell>
        <mxCell id="t23" value="Bytes all the way down — what each key is made of" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#3c4043;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="604" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="b24" value="canonical rows&lt;br&gt;json.dumps(sort_keys=True, default=str)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="46" y="650" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="b25" value="⚪ reference_digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="316" y="656" width="170" height="44" as="geometry"/></mxCell>
        <mxCell id="b26" value="🗄️ rag_chunks&lt;br&gt;(reference_digest, chunk_kind, embedder id, version)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="636" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="b27" value="🗄️ freetext_pools&lt;br&gt;(reference_digest, model_uri) → one row per column" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="696" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="b28" value="🗄️ validation_runs&lt;br&gt;provenance of every landed table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="756" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b24" target="b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b25" target="b26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b25" target="b27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b25" target="b28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b33" value="8 seed strings&lt;br&gt;(deterministic retrieval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="b34" value="prompt bytes&lt;br&gt;static prefix + seeds + clause" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1110" y="650" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="b35" value="🧠 KV blocks&lt;br&gt;hashed by their tokens + prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1310" y="650" width="146" height="56" as="geometry"/></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b26" target="b33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b33" target="b34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b34" target="b35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b39" value="💬 Change one SAMPLED row and the digest changes: new chunks, new pools, a cold run — by design. Change nothing and the second run never opens a CUDA context. kcenter_rotate is the one strategy that gives the last link up, on purpose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="726" width="556" height="80" as="geometry"/></mxCell>
        <mxCell id="t40" value="Claim: the package and the pipeline solve different problems; what this pipeline needs from a chunk is not a splitter but an identity every worker can recompute." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="848" width="1400" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
