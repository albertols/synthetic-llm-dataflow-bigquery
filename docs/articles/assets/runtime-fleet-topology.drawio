<mxfile host="app.diagrams.net">
  <diagram id="RuntimeFleetTopology" name="RuntimeFleetTopology">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="800" as="geometry"/></mxCell>
        <mxCell id="t1" value="One worker pool, every stage — what Dataflow starts for a run, and what each GPU worker pulls" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="12" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="orange = Apache Beam SDK harness / DoFn code · purple = GPU tenants · green = CPU engine work · blue = stores · gray = runner facts · the in-worker anatomy (threads, GILs, the spawn mutex) is its own figure" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="38" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="g3" value="" style="sketch=0;dashed=0;connectable=1;html=1;fillColor=#4184F3;strokeColor=none;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_dataflow;" vertex="1" parent="1"><mxGeometry x="48" y="78" width="52" height="46" as="geometry"/></mxCell>
        <mxCell id="svc" value="Dataflow service — the Flex Template LAUNCHER runs first (its own container, ~10 min of the wall clock): reference SELECT, profiler, generation_plan + relationship card, taint preflight, GPU verdict — then it requests the worker pool with the DAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="110" y="74" width="640" height="56" as="geometry"/></mxCell>
        <mxCell id="c4" value="⚙️ launch knobs that shape the fleet&lt;br&gt;initial_workers = max workers → the fleet starts FULL · autoscaling=fixed → it STAYS full (THROUGHPUT_BASED ramped 1→4 and dipped to 1–2 between a parent&#x27;s load and its child&#x27;s pool phase) · sdk_containers=single|multi · gpu=t4|l4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="770" y="74" width="590" height="56" as="geometry"/></mxCell>
        <mxCell id="e5" value="requests the pool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pool" value="the ONE worker pool — n1-standard-8 + 1 × NVIDIA T4 per worker (gpu=t4) or g2-standard-8 + 1 × L4 (gpu=l4); CPU stages and GPU stages run on the same VMs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1320" height="380" as="geometry"/></mxCell>
        <mxCell id="ff6" value="" style="shape=image;html=1;imageAspect=1;image=data:image/png," vertex="1" parent="1"><mxGeometry x="1312" y="158" width="34" height="42" as="geometry"/></mxCell>
        <mxCell id="w0" value="worker 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="305" height="320" as="geometry"/></mxCell>
        <mxCell id="c7" value="🔀 Runner v2 SDK harness (Apache Beam Python SDK) — one container image for launcher and workers · single: 1 process · 8 threads · 1 GIL · multi: 8 processes · 8 GILs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="68" y="214" width="288" height="62" as="geometry"/></mxCell>
        <mxCell id="c8" value="⚙️ engines — built once per process in DoFn.setup(), shared by the process&#x27;s threads (engine_shared holders=N); pure NumPy at generate time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="68" y="284" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c9" value="🧠 vLLM OpenAI server :8000 — ONE per worker, spawned lazily by the first LLM call, reached over loopback HTTP by every thread and process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="68" y="350" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c10" value="🧠 BgeEmbedder — CUDA on the cold path, demoted to CPU before vLLM sizes its KV budget; at most rag_embed_shards embedders per job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1;fontColor=#3f1f7a;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="68" y="416" width="288" height="52" as="geometry"/></mxCell>
        <mxCell id="c11" value="T4 · 16 GB · no egress: 127.0.0.1 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="68" y="476" width="288" height="30" as="geometry"/></mxCell>
        <mxCell id="w1" value="worker 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="385" y="196" width="305" height="320" as="geometry"/></mxCell>
        <mxCell id="c12" value="🔀 Runner v2 SDK harness (Apache Beam Python SDK) — one container image for launcher and workers · single: 1 process · 8 threads · 1 GIL · multi: 8 processes · 8 GILs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="393" y="214" width="288" height="62" as="geometry"/></mxCell>
        <mxCell id="c13" value="⚙️ engines — built once per process in DoFn.setup(), shared by the process&#x27;s threads (engine_shared holders=N); pure NumPy at generate time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="393" y="284" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c14" value="🧠 vLLM OpenAI server :8000 — ONE per worker, spawned lazily by the first LLM call, reached over loopback HTTP by every thread and process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="393" y="350" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c15" value="🧠 BgeEmbedder — CUDA on the cold path, demoted to CPU before vLLM sizes its KV budget; at most rag_embed_shards embedders per job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1;fontColor=#3f1f7a;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="393" y="416" width="288" height="52" as="geometry"/></mxCell>
        <mxCell id="c16" value="T4 · 16 GB · no egress: 127.0.0.1 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="393" y="476" width="288" height="30" as="geometry"/></mxCell>
        <mxCell id="w2" value="worker 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="196" width="305" height="320" as="geometry"/></mxCell>
        <mxCell id="c17" value="🔀 Runner v2 SDK harness (Apache Beam Python SDK) — one container image for launcher and workers · single: 1 process · 8 threads · 1 GIL · multi: 8 processes · 8 GILs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="718" y="214" width="288" height="62" as="geometry"/></mxCell>
        <mxCell id="c18" value="⚙️ engines — built once per process in DoFn.setup(), shared by the process&#x27;s threads (engine_shared holders=N); pure NumPy at generate time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="718" y="284" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c19" value="🧠 vLLM OpenAI server :8000 — ONE per worker, spawned lazily by the first LLM call, reached over loopback HTTP by every thread and process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="718" y="350" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c20" value="🧠 BgeEmbedder — CUDA on the cold path, demoted to CPU before vLLM sizes its KV budget; at most rag_embed_shards embedders per job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1;fontColor=#3f1f7a;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="718" y="416" width="288" height="52" as="geometry"/></mxCell>
        <mxCell id="c21" value="T4 · 16 GB · no egress: 127.0.0.1 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="718" y="476" width="288" height="30" as="geometry"/></mxCell>
        <mxCell id="w3" value="worker 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1035" y="196" width="305" height="320" as="geometry"/></mxCell>
        <mxCell id="c22" value="🔀 Runner v2 SDK harness (Apache Beam Python SDK) — one container image for launcher and workers · single: 1 process · 8 threads · 1 GIL · multi: 8 processes · 8 GILs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1043" y="214" width="288" height="62" as="geometry"/></mxCell>
        <mxCell id="c23" value="⚙️ engines — built once per process in DoFn.setup(), shared by the process&#x27;s threads (engine_shared holders=N); pure NumPy at generate time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1043" y="284" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c24" value="🧠 vLLM OpenAI server :8000 — ONE per worker, spawned lazily by the first LLM call, reached over loopback HTTP by every thread and process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1043" y="350" width="288" height="58" as="geometry"/></mxCell>
        <mxCell id="c25" value="🧠 BgeEmbedder — CUDA on the cold path, demoted to CPU before vLLM sizes its KV budget; at most rag_embed_shards embedders per job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1;fontColor=#3f1f7a;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1043" y="416" width="288" height="52" as="geometry"/></mxCell>
        <mxCell id="c26" value="T4 · 16 GB · no egress: 127.0.0.1 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1043" y="476" width="288" height="30" as="geometry"/></mxCell>
        <mxCell id="g27" value="" style="sketch=0;dashed=0;connectable=1;html=1;fillColor=#4184F3;strokeColor=none;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_storage;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="52" height="46" as="geometry"/></mxCell>
        <mxCell id="gcs" value="🪣 GCS — model weights per family/model/version (pulled once per worker to /local-ssd/model, never from a model hub), the embedder, the DDL pin, the freetext_pools / rag_chunks override URIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="120" y="574" width="560" height="58" as="geometry"/></mxCell>
        <mxCell id="g28" value="" style="sketch=0;dashed=0;connectable=1;html=1;fillColor=#4184F3;strokeColor=none;shape=mxgraph.gcp2.hexIcon;prIcon=bigquery;" vertex="1" parent="1"><mxGeometry x="720" y="580" width="52" height="46" as="geometry"/></mxCell>
        <mxCell id="bq" value="🗄️ BigQuery — source table (reference sample, source domains via the Storage Read API, taint queries) · synthetic_rag.rag_chunks + freetext_pools (persisted artifacts keyed by reference digest) · landing tables, DLQ, validation_runs (FILE_LOADS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="780" y="574" width="580" height="58" as="geometry"/></mxCell>
        <mxCell id="e29" value="pull once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w0" target="gcs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e30" value="read / load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w3" target="bq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c31" value="⚪ what the runner spawns per worker is the whole CPU story: under single the eight harness threads share one interpreter and the generate stage is GIL-bound; under multi every vCPU runs bundles and the ceiling moves to the shuffle write and the BigQuery load. The GPU tenant count is the same in both: one vLLM server per worker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="652" width="800" height="66" as="geometry"/></mxCell>
        <mxCell id="c32" value="⚪ the bill: every worker carries its accelerator for the whole job, while the GPU is busy only during the population embed and the pool ladders. A warm digest never ignites vLLM; a job whose routes need no LLM is submitted CPU-only by verdict (llm_route_unused)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="860" y="652" width="500" height="66" as="geometry"/></mxCell>
        <mxCell id="t33" value="Claim: one pool of identical GPU workers runs every stage; the GPU is a bounded, front-loaded tenant of each worker and the CPU topology is what the runner is told to spawn." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="1280" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
