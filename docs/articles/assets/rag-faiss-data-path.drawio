  <diagram id="RagFaissDataPath" name="RagFaissDataPath">
    <mxGraphModel dx="1500" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="1010" as="geometry"/></mxCell>
        <mxCell id="t1" value="What the index actually holds: text becomes a unit vector, vectors are persisted in BigQuery, FAISS is a matrix in worker RAM — and only strings ever reach the LLM" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="10" width="1400" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="grey = data · green = CPU code (module::function) · purple = GPU · blue = BigQuery · toy table demo.card_transactions — every literal below is printed by scripts/doc/b1_rag_walkthrough.py" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="36" width="1400" height="20" as="geometry"/></mxCell>
        <mxCell id="f3" value="chunk_kind = row_doc — a whole reference row (first 1,024 rows of the sample)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6b7280;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="900" height="170" as="geometry"/></mxCell>
        <mxCell id="b4" value="{&quot;txn_id&quot;: &quot;T00104&quot;, &quot;channel&quot;: &quot;pos&quot;,&lt;br&gt;&quot;amount&quot;: 4.5, &quot;currency&quot;: &quot;EUR&quot;,&lt;br&gt;&quot;merchant_name&quot;: &quot;CAFE ARBOL*MADRID&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="46" y="96" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="⚙️ serialize.py::serialize_row&lt;br&gt;GReaT sentence, schema column order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="376" y="100" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="b6" value="txn_id is T00104, channel is pos, amount is 4.5, currency is EUR, merchant_name is CAFE ARBOL*MADRID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="626" y="96" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b9" value="🔑 row_digest = sha256(json.dumps(row, sort_keys=True, default=str)) = cd7e7c76… · chunk_id = blake2b(source_fqn : row_digest : 0) = e4046e57… — same bytes in, same ids out, on any worker, on any run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="180" width="870" height="44" as="geometry"/></mxCell>
        <mxCell id="f10" value="chunk_kind = free_text_col — one DISTINCT value of one free-text column (≤ 1,024 per column)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6b7280;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="900" height="170" as="geometry"/></mxCell>
        <mxCell id="b11" value="merchant_name&lt;br&gt;96 rows → 81 distinct values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="46" y="284" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="b12" value="⚙️ chunking.py::chunk_free_text_value&lt;br&gt;the value IS the chunk text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="376" y="284" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="b13" value="CAFE ARBOL*MADRID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="626" y="284" width="290" height="62" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b16" value="🔑 row_digest = sha256({column, value}) = dd373607… · source_pk = NULL — a value chunk carries no row and no key: deduplicated, and privacy-positive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="364" width="870" height="44" as="geometry"/></mxCell>
        <mxCell id="b17" value="🧠 embedding.py::BgeEmbedder.embed&lt;br&gt;bge-small-en-v1.5 · local weights from GCS&lt;br&gt;tokenize ≤ 512 → mean-pool → L2-normalize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="190" width="250" height="86" as="geometry"/></mxCell>
        <mxCell id="b18" value="v = [ v₁, v₂, … , v₃₈₄ ]&lt;br&gt;‖v‖ = 1  (a unit vector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1260" y="198" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b22" value="💬 device=auto: CUDA if ≥ 512 MiB is free, else CPU — and its callers demote it to CPU before vLLM sizes its KV budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1.3;fontColor=#3c1f6e;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="96" width="490" height="50" as="geometry"/></mxCell>
        <mxCell id="g23" value="" style="sketch=0;dashed=0;connectable=1;html=1;fillColor=#4184F3;strokeColor=none;shape=mxgraph.gcp2.hexIcon;prIcon=bigquery;" vertex="1" parent="1"><mxGeometry x="964" y="330" width="36" height="32" as="geometry"/></mxCell>
        <mxCell id="b24" value="🗄️ synthetic_rag.rag_chunks — PERSISTED&lt;br&gt;chunk_id · chunk_kind · chunk_text · embedding ARRAY&amp;lt;FLOAT64&amp;gt; · row_digest · reference_digest · embedder_id · embedder_version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1006" y="316" width="454" height="76" as="geometry"/></mxCell>
        <mxCell id="e25" value="population branch, cold digest only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3fbf7;strokeColor=#1baf7a;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#127a55;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="446" width="640" height="350" as="geometry"/></mxCell>
        <mxCell id="t27" value="FAISS IndexFlatIP — NOT persisted: rebuilt in RAM by every engine build  (index.py::build_index)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#127a55;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="766" width="610" height="22" as="geometry"/></mxCell>
        <mxCell id="b28" value="&lt;b&gt;column index — the live one&lt;/b&gt; (centroid strategy)&lt;br&gt;M · float32 · n × 384 &amp;nbsp;(n ≤ 1,024 distinct values)&lt;br&gt;&lt;br&gt;id 0 &amp;nbsp;&amp;nbsp;[ v₀,₁ &amp;nbsp; v₀,₂ &amp;nbsp; … &amp;nbsp; v₀,₃₈₄ ]&lt;br&gt;id 1 &amp;nbsp;&amp;nbsp;[ v₁,₁ &amp;nbsp; v₁,₂ &amp;nbsp; … &amp;nbsp; v₁,₃₈₄ ]&lt;br&gt;&amp;nbsp;⋮ &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;throwaway: built, asked once, released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="462" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="b29" value="&lt;b&gt;row index&lt;/b&gt; — 1,024 row_doc vectors × 384, same construction, built by every engine build. Its one centroid query returns 8 exemplar ROWS: a fallback seed source the current wiring never reaches (the same 1,024-row prefix feeds the column path first)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#c3cad3;strokeWidth=1.3;fontColor=#4b5563;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="624" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="b30" value="no training · no graph · no centroid file · no service — &amp;quot;search&amp;quot; is one matrix–vector product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f6ee;strokeColor=#1baf7a;strokeWidth=1.3;fontColor=#0d4a34;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="724" width="604" height="34" as="geometry"/></mxCell>
        <mxCell id="b31" value="⚙️ retrieval.py::retrieve_centroid_top_k&lt;br&gt;&lt;br&gt;c = mean of the vectors&lt;br&gt;scores = M · c/‖c‖&lt;br&gt;ids = the 8 highest scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="426" y="462" width="228" height="150" as="geometry"/></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b28" target="b31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e33" value="Generate engines only: row vectors read back, all-or-nothing  (b1_chunks_reused)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b24" target="b29"><mxGeometry x="-0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="1051" y="430"/><mxPoint x="20" y="430"/><mxPoint x="20" y="670"/></Array></mxGeometry></mxCell>
        <mxCell id="b34" value="💬 id → text is a Python list kept beside M: FAISS returns integers, the engine turns them back into strings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="426" y="624" width="228" height="92" as="geometry"/></mxCell>
        <mxCell id="b35" value="8 seeds — STRINGS&lt;br&gt;&lt;br&gt;CAFE ARBOL*MADRID&lt;br&gt;CAFE ARBOL*VALENCIA&lt;br&gt;CAFE ARBOL*BILBAO&lt;br&gt;… 5 more" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="712" y="462" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="b36" value="⚙️ engine.py::_build_pool_prompt&lt;br&gt;&lt;br&gt;static instructions&lt;br&gt;+ column name&lt;br&gt;+ Examples: [8 seeds]&lt;br&gt;+ Column constraint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="996" y="462" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="b37" value="🧠 vLLM&lt;br&gt;guided JSON&lt;br&gt;{&amp;quot;values&amp;quot;: [32 strings]} × n=4&lt;br&gt;&lt;br&gt;then the gates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1280" y="462" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b31" target="b35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e39" value="augment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b35" target="b36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e40" value="generate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b36" target="b37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b41" value="💬 &lt;b&gt;Retrieval → Augmentation → Generation&lt;/b&gt;, in that order and once per column. The vectors stop at the seed picker: what crosses into the prompt is eight short strings, and what comes back is checked against the sample and the column&#x27;s full source domain before it may enter a pool." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="712" y="624" width="748" height="66" as="geometry"/></mxCell>
        <mxCell id="b42" value="💬 Where M&#x27;s vectors come from: the pool branch embeds the column&#x27;s distinct values itself (no chunk store is attached there); a Generate engine that has to ladder reads them from rag_chunks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4eefb;strokeColor=#2a78d6;strokeWidth=1.3;fontColor=#143a66;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="712" y="700" width="748" height="58" as="geometry"/></mxCell>
        <mxCell id="f43" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa0a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="816" width="1440" height="120" as="geometry"/></mxCell>
        <mxCell id="t44" value="What is deliberately NOT in this picture" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3c4043;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="822" width="500" height="22" as="geometry"/></mxCell>
        <mxCell id="b45" value="&lt;b&gt;✗ no per-row query&lt;/b&gt;&lt;br&gt;generation never calls the index — rows are NumPy draws" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#c3cad3;strokeWidth=1.3;fontColor=#4b5563;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="850" width="340" height="72" as="geometry"/></mxCell>
        <mxCell id="b46" value="&lt;b&gt;✗ no approximate search&lt;/b&gt;&lt;br&gt;IVF / HNSW / PQ trade recall for speed the pipeline does not need at n ≤ 1,024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#c3cad3;strokeWidth=1.3;fontColor=#4b5563;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="402" y="850" width="340" height="72" as="geometry"/></mxCell>
        <mxCell id="b47" value="&lt;b&gt;✗ no vector database&lt;/b&gt;&lt;br&gt;the store is a BigQuery table read once; the search is in-process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#c3cad3;strokeWidth=1.3;fontColor=#4b5563;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="758" y="850" width="340" height="72" as="geometry"/></mxCell>
        <mxCell id="b48" value="&lt;b&gt;✗ no index file&lt;/b&gt;&lt;br&gt;rebuilding costs a fraction of a second; persisting vectors, not indexes, keeps the format portable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#c3cad3;strokeWidth=1.3;fontColor=#4b5563;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1114" y="850" width="340" height="72" as="geometry"/></mxCell>
        <mxCell id="t49" value="Claim: the index is a ≤ 1.5 MB matrix asked a handful of questions per engine build; persistence, identity and privacy live in the chunk bytes, not in FAISS." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="952" width="1400" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
