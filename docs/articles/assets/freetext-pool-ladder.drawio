<mxfile host="app.diagrams.net">
  <diagram id="freetext-ladder" name="FreetextPoolLadder">
    <mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="860" as="geometry"/></mxCell>
        <mxCell id="title" value="The pool ladder — what one free-text column costs the LLM, and the gates every candidate value must pass" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="12" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="sub" value="one column, one ladder; each round is ONE vLLM request; 🔑 purple = the KV prefix, paid for once and reused every round; the gates run in this exact order; every exit is a named worker-log milestone" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="100" y="38" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="target" value="⚙️ target size — how many values to ask for&lt;br&gt;min(512, num_rows, distinct) where distinct = exact source stats → source-filter cardinality → sample distinct&lt;br&gt;(ADR 0033 D2 — the filter is fetched BEFORE sizing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="prompt" value="⚙️ the prompt = the KV prefix — byte-identical per column&lt;br&gt;shared instruction prefix → 8 seed exemplars (rag_chunks or FAISS centroid) → rendered llm_prompt_constraint clause (fixed key order) → length hint&lt;br&gt;&lt;b&gt;computed by vLLM once, reused on every round: only the sampling parameters change&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#7a3fd1;strokeWidth=4;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="kv-badge" value="🔑 KV PREFIX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="preflight" value="⚙️ example preflight (ADR 0033 D4)&lt;br&gt;the clause's own fictitious examples are judged by the column's format gate first — an off-length example would poison every round&lt;br&gt;(prompt_constraint_example_off_format)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e-t-p" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="target" target="prompt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-p-pf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prompt" target="preflight"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="frame" value="one round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontColor=#3c4043;fontSize=11;align=center;verticalAlign=top;spacingTop=2;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="76" width="640" height="620" as="geometry"/></mxCell>
        <mxCell id="call" value="🧠 vLLM — one guided-JSON request: an ARRAY of 32 values, n = 4 independent completions&lt;br&gt;chat endpoint, response_format=json_schema (a user pattern becomes the grammar), no request seed with n &gt; 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="104" width="520" height="64" as="geometry"/></mxCell>
        <mxCell id="parse" value="⚪ parse — the JSON array of strings; non-JSON completions are dropped with a WARNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="184" width="520" height="40" as="geometry"/></mxCell>
        <mxCell id="clamp" value="gate 1 · clamp to the length ceiling — prose and mask-gated columns only: p95 == max and a real tail ⇒ a fixed-width field; longer candidates are CUT, not rejected (freetext_pool_length_clamped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="gate" value="gate 2 · format gate — identifier-ish: length bucket ∧ charset ∧ no column-name echo · mask-gated: collapsed mask must be an observed mask · prose: passes&lt;br&gt;(the gate is built from the reference sample's shapes, never from the LLM's output)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="collapse" value="gate 3 · format collapse — two consecutive full rounds with zero in-format values end the ladder (freetext_pool_format_collapse → stagnated → shape fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="376" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="novel" value="gate 4 · novelty — reject anything in observed sample ∪ FULL source domain ∪ clause examples; dedupe against the pool so far; count echoes of the seeds&lt;br&gt;(this is where freetext.copy_fraction = 0 becomes a property of the artifact)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="436" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="stag" value="gate 5 · stagnation — fewer than 4 novel values for 3 rounds, after every escalation level has run once ⇒ stop (freetext_pool_stagnated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="512" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="escalate" value="🔁 escalate and go again — temperature 0.7 → 1.0 (top_p 1.0, top_k 0) → 1.3; rounds capped at max(3, 2 × ⌈target / 128⌉)&lt;br&gt;&lt;b&gt;🔑 the prompt bytes never change between rounds, so vLLM serves the next round from the cached KV prefix&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b89ae6;strokeColor=#7a3fd1;strokeWidth=4;fontColor=#2b1651;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="576" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="ready" value="✅ target reached → freetext_pool_built — values, attempts, stagnated flag; persisted by the pool branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="650" width="520" height="36" as="geometry"/></mxCell>
        <mxCell id="e-call-parse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="parse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-parse-clamp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="parse" target="clamp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-clamp-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clamp" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-gate-collapse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="collapse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-collapse-novel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="collapse" target="novel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-novel-stag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="novel" target="stag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-stag-escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stag" target="escalate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a3fd1;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="escalate" target="call"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="606"/><mxPoint x="960" y="136"/></Array></mxGeometry></mxCell>
        <mxCell id="e-loop-l" value="next round&lt;br&gt;🔑 KV prefix hit" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#7a3fd1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-loop"><mxGeometry x="-0.36" relative="1" as="geometry"><mxPoint x="18" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-stag-ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stag" target="ready"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="534"/><mxPoint x="390" y="668"/></Array></mxGeometry></mxCell>
        <mxCell id="e-stag-ready-l" value="pool full" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#127a55;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-stag-ready"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-pf-call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a3fd1;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="preflight" target="call"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="345"/><mxPoint x="360" y="136"/></Array></mxGeometry></mxCell>
        <mxCell id="e-pf-call-l" value="🔑 round 1: prefix computed" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#7a3fd1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-pf-call"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="20" y="-40" as="offset"/></mxGeometry></mxCell>
        <mxCell id="x-fallback" value="⚙️ shape fallback (freetext_pool_shape_fallback)&lt;br&gt;the LLM produced values but every one was a copy or off-format: draw novel values from the column's own per-position shapes, rejecting the source domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="104" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="x-topup" value="⚙️ shape top-up (freetext_pool_shape_topup)&lt;br&gt;the pool is real but short of target: fill the gap with verified-novel template values; still short ⇒ freetext_pool_undersized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="194" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="x-binary" value="⚙️ binary template (freetext_pool_byte_template)&lt;br&gt;control-character payloads never go to the LLM at all: literal prefix + length-pinned random tail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="276" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="x-transient" value="⚙️ transient failure (freetext_pool_ladder_retried)&lt;br&gt;vLLM not ready or unfittable: the column is rebuilt ONCE, sequentially, after its siblings — never swallowed into a lax fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="358" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="x-strict" value="🛡️ strict_freetext (default with a real model client)&lt;br&gt;nothing usable after every level ⇒ FreeTextEmptyYieldError out of DoFn.setup() — the run fails instead of landing exemplar copies&lt;br&gt;lax (fake client only) ⇒ freetext_llm_fallback WARNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="x-store" value="🗄️ persisted pool — freetext_pools&lt;br&gt;(reference_digest, model_uri, column, target) + attempts + stagnated: a later worker reads the conclusion, not the ladder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="536" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="e-collapse-x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="collapse" target="x-fallback"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="398"/><mxPoint x="1040" y="141"/></Array></mxGeometry></mxCell>
        <mxCell id="e-stag-x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stag" target="x-topup"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="534"/><mxPoint x="1030" y="227"/></Array></mxGeometry></mxCell>
        <mxCell id="e-call-x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="x-transient"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1046" y="136"/><mxPoint x="1046" y="391"/></Array></mxGeometry></mxCell>
        <mxCell id="e-ready-store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="x-store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1046" y="668"/><mxPoint x="1046" y="566"/></Array></mxGeometry></mxCell>
        <mxCell id="claim" value="Claim: a cold column costs a handful of array requests, not a request per value — and every candidate passes clamp → format → collapse → novelty → stagnation in that order, so a pool can be short or empty but never a copy." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="100" y="720" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="foot" value="Numbers here are configuration constants (pool cap 512, 32 values × n = 4 per round, 3 temperature levels, 8 seeds, 1M-value domain cap); measured run figures live in the design docs' figure scripts." style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="1200" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
