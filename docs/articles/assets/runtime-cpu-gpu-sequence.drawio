<mxfile host="app.diagrams.net">
  <diagram id="RuntimeCpuGpuSequence" name="RuntimeCpuGpuSequence">
    <mxGraphModel dx="1400" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1090" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="1090" as="geometry"/></mxCell>
        <mxCell id="t1" value="A relational run end to end — who does what, on which silicon" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="12" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="green = CPU (driver + worker harness threads) · purple = the T4 · orange = Beam runner services · blue = stores · purple bars = GPU busy · gray band = GPU idle but billed · ⚪ milestones in parentheses" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="38" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="p0" value="⚙️ launcher&lt;br&gt;(driver process, CPU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l3" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="118" as="sourcePoint"/><mxPoint x="120" y="962" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p1" value="🔀 Dataflow service&lt;br&gt;(runner, shuffle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="252" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l4" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="118" as="sourcePoint"/><mxPoint x="330" y="962" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p2" value="🔀 worker CPU&lt;br&gt;(harness threads · engines)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="462" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l5" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="118" as="sourcePoint"/><mxPoint x="540" y="962" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3" value="🧠 worker GPU&lt;br&gt;(T4: embedder · vLLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="822" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l6" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="118" as="sourcePoint"/><mxPoint x="900" y="962" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p4" value="🗄️ BigQuery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1012" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l7" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="118" as="sourcePoint"/><mxPoint x="1090" y="962" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5" value="🪣 GCS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1192" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l8" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="118" as="sourcePoint"/><mxPoint x="1270" y="962" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l9" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="150" as="sourcePoint"/><mxPoint x="1090" y="150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t10" value="① reference SELECT — 10k rows in FARM_FINGERPRINT order → reference_digest · landing-table descriptions from INFORMATION_SCHEMA · taint preflight (one overlap query per column)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="126" y="120" width="958" height="28" as="geometry"/></mxCell>
        <mxCell id="l11" value="" style="edgeStyle=none;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="174" as="sourcePoint"/><mxPoint x="120" y="174" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t12" value="sample rows · exact stats (optional) · overlap counts only, never values" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1d5599;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="126" y="176" width="958" height="28" as="geometry"/></mxCell>
        <mxCell id="c13" value="② profile → generation_plan (one route per column) · relationship card (PK/FK model, config only) · row projection · GPU verdict: no Tier-L route ⇒ CPU-only job (llm_route_unused)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="132" y="212" width="560" height="46" as="geometry"/></mxCell>
        <mxCell id="l14" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="305" as="sourcePoint"/><mxPoint x="330" y="305" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t15" value="③ submit the Flex Template job (launcher_start … autoscale) — the launcher container is the first ~10 minutes" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="126" y="275" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="c16" value="boot the pool: image pull + NVIDIA driver install (~5 min) · initial_workers=max → no ramp · autoscaling=fixed → no dips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe3d9;strokeColor=#eb6834;strokeWidth=1;fontColor=#7a2e12;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="342" y="323" width="430" height="44" as="geometry"/></mxCell>
        <mxCell id="l17" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="395" as="sourcePoint"/><mxPoint x="1270" y="395" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t18" value="④ once per worker: model weights + embedder to /local-ssd (model_pull_done) — no model hub, no egress" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="546" y="365" width="718" height="28" as="geometry"/></mxCell>
        <mxCell id="l19" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="440" as="sourcePoint"/><mxPoint x="900" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t20" value="⑤ population branch (cold RAG only): embed reference chunks — at most rag_embed_shards processes (RagEmbedChunks)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="546" y="410" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="894" y="440" width="12" height="35" as="geometry"/></mxCell>
        <mxCell id="l22" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="480" as="sourcePoint"/><mxPoint x="1090" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t23" value="write rag_chunks" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="546" y="482" width="538" height="28" as="geometry"/></mxCell>
        <mxCell id="l24" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="530" as="sourcePoint"/><mxPoint x="900" y="530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t25" value="⑥ pool branch (cold pools only), after AwaitRagPopulation: spawn ONE vLLM per worker, run every Tier-L ladder concurrently (freetext_pool_built)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="546" y="500" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="c26" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="894" y="530" width="12" height="80" as="geometry"/></mxCell>
        <mxCell id="l27" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="610" as="sourcePoint"/><mxPoint x="1090" y="610" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t28" value="blocking LOAD → freetext_pools · AwaitFreeTextPools opens" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="546" y="612" width="538" height="28" as="geometry"/></mxCell>
        <mxCell id="c29" value="GPU idle from here — still billed for the rest of the job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=8.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;dashed=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="856" y="640" width="88" height="300" as="geometry"/></mxCell>
        <mxCell id="c30" value="⑦ GenerateRecordsDoFn — batches of 10k rows: NumPy marginals, pool draws, identity synthesis, FK keys from the PARENT&#x27;s landed keys (side input) — no GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe3d9;strokeColor=#eb6834;strokeWidth=1;fontColor=#7a2e12;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="552" y="650" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c31" value="⑧ three lines of defense — Pydantic per record → Pandera per batch → uniqueness / FK integrity; every invalid row → a tagged DLQ output with rule_id + payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="552" y="725" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="l32" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="830" as="sourcePoint"/><mxPoint x="330" y="830" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t33" value="⑨ uniqueness_mode=exact: ONE full-row barrier through Dataflow Shuffle (rows as value tuples; PK/identity groups as side inputs)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="336" y="800" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="l34" value="" style="edgeStyle=none;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#b44f26;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="854" as="sourcePoint"/><mxPoint x="540" y="854" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t35" value="survivors (smallest digest) + duplicate envelopes" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#b44f26;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="336" y="856" width="198" height="28" as="geometry"/></mxCell>
        <mxCell id="l36" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="895" as="sourcePoint"/><mxPoint x="1090" y="895" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t37" value="⑩ FILE_LOADS — landing table · DLQ table · validation_runs (load jobs, never streaming inserts)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="546" y="865" width="538" height="28" as="geometry"/></mxCell>
        <mxCell id="c38" value="⑪ BLOCKER gate after the load commits: pk.duplicate · fk.orphan · freetext.copy_fraction · dlq ratio → PASSED / FAILED_BLOCKER in validation_runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="552" y="908" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="c39" value="⑫ child tables repeat ⑥ → ⑪ in the SAME job, driven by their parents&#x27; landed keys — one boot, one ignition, one prefix cache for every table (ADR 0030 / 0036)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="960" y="908" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="c40" value="💬 The GPU is touched in two bounded, front-loaded stages (⑤ ⑥) before the first row exists; both are skipped on a warm digest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="420" height="54" as="geometry"/></mxCell>
        <mxCell id="c41" value="💬 Everything after the pool barrier is CPU, Dataflow Shuffle and BigQuery load jobs — the levers there are interpreters per worker, barriers per table and a fleet that starts full." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="490" y="980" width="420" height="54" as="geometry"/></mxCell>
        <mxCell id="c42" value="💬 Rows never land before their gates; duplicates and orphans are counted and diverted, and the run&#x27;s verdict is a row in validation_runs, not a log line." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="940" y="980" width="420" height="54" as="geometry"/></mxCell>
        <mxCell id="t43" value="Claim: a relational launch is one job on one pool — the driver decides, the GPU seeds, the CPU generates and defends, the runner shuffles once, BigQuery loads and judges." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="1046" width="1280" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
