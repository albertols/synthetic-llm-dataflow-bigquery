        <mxCell id="b54" value="💬 The index is never persisted — vectors are. FAISS is rebuilt in a fraction of a second and asked one centroid question per laddered column (plus one over the row vectors: a fallback that, as wired, never fires). Under kcenter the seed pick needs no index." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="566" width="656" height="60" as="geometry"/></mxCell>
        <mxCell id="b55" value="💬 Rejection set = observed sample ∪ the column&#x27;s FULL source domain (≤ 1M distinct) ∪ clause examples — a seed the model echoes is counted, then dropped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="746" y="566" width="692" height="60" as="geometry"/></mxCell>
        <mxCell id="f56" value="③ Generate — every run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa0a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="668" width="1440" height="288" as="geometry"/></mxCell>
        <mxCell id="m57" value="" style="shape=image;html=1;imageAspect=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="46" y="702" width="34" height="42" as="geometry"/></mxCell>
