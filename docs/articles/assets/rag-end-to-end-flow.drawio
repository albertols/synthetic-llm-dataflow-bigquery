        <mxCell id="t86" value="freetext.copy_fraction is scored after the run, by the E2E probe" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#5f6368;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1104" y="932" width="296" height="18" as="geometry"/></mxCell>
        <mxCell id="e87" value="dlq_by_rule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#127a55;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b77" target="b78"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="902"/></Array></mxGeometry></mxCell>
        <mxCell id="b88" value="⚙️ per row, NumPy only — numerics by inverse CDF · categoricals at source frequency · identifiers from shapes · FK tuples from the parent&#x27;s landed keys · &lt;b&gt;free-text = a head literal at its source share, else a draw from the pool with replacement&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f6ee;strokeColor=#1baf7a;strokeWidth=1.3;fontColor=#0d4a34;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="90" y="772" width="620" height="74" as="geometry"/></mxCell>
        <mxCell id="b89" value="💬 Retrieval never runs per row. A 10M-row table and a 1k-row table cost the same embed, the same index, the same eight seeds per column." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="90" y="860" width="620" height="50" as="geometry"/></mxCell>
        <mxCell id="t90" value="Claim: retrieval is a once-per-column prompt-seeding step inside the pool branch&#x27;s setup(); the row path is NumPy, three lines of defense and a load job." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="968" width="1380" height="26" as="geometry"/></mxCell>
