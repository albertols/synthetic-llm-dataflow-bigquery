        <mxCell id="b54" value="identifier shapes + expansion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="626" y="645" width="248" height="38" as="geometry"/></mxCell>
        <mxCell id="b55" value="escalating_sampling() ladder → 1.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="626" y="690" width="248" height="38" as="geometry"/></mxCell>
        <mxCell id="b56" value="full-source-domain rejection (ADR 0023)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="626" y="735" width="248" height="38" as="geometry"/></mxCell>
        <mxCell id="b57" value="strict_freetext: fail, never copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="626" y="780" width="248" height="38" as="geometry"/></mxCell>
        <mxCell id="b58" value="three lines of defense + DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="626" y="825" width="248" height="38" as="geometry"/></mxCell>
        <mxCell id="b59" value="💬 &lt;b&gt;Attach&lt;/b&gt; = one launch parameter. &lt;b&gt;Detach&lt;/b&gt; is a convention, not code: the population and pool branches are engine-blind, so a b2_library launch leaves embedder_uri, build_rag_layer and build_pool_layer empty — otherwise the job embeds chunks b2 never reads and runs a pool branch that fits a model and persists nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="896" width="1440" height="46" as="geometry"/></mxCell>
        <mxCell id="t60" value="Claim: swapping engines changes what setup() builds and what a batch draws from — never the graph, the guardrails or the sinks." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="946" width="1400" height="26" as="geometry"/></mxCell>
