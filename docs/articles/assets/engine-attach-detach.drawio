<mxfile host="app.diagrams.net">
  <diagram id="EngineAttachDetach" name="EngineAttachDetach">
    <mxGraphModel dx="1500" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="980" as="geometry"/></mxCell>
        <mxCell id="t1" value="One seam, two engines: the DAG never changes — a string picks the class, an ABC fixes the lifecycle, a Protocol carries the LLM" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="10" width="1400" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="orange = Beam (sdfb-beam) · green = engine code (sdfb-core, no Beam import) · purple = GPU · blue = BigQuery · the import direction is strict: sdfb-beam → sdfb-core, never back" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="36" width="1400" height="20" as="geometry"/></mxCell>
        <mxCell id="f3" value="The row path — identical for both engines (there is no `if engine ==` anywhere in sdfb-beam)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#eb6834;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#b44f26;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="1440" height="118" as="geometry"/></mxCell>
        <mxCell id="m4" value="" style="shape=image;html=1;imageAspect=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="46" y="100" width="34" height="42" as="geometry"/></mxCell>
        <mxCell id="b5" value="🔀 CreateRequests&lt;br&gt;or parent-key batches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="92" y="100" width="170" height="52" as="geometry"/></mxCell>
        <mxCell id="b6" value="🔀 Generate DoFn&lt;br&gt;setup · process · teardown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="288" y="100" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="b7" value="🧺 rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="514" y="100" width="70" height="52" as="geometry"/></mxCell>
        <mxCell id="b8" value="🛡️ FK integrity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="120" height="52" as="geometry"/></mxCell>
        <mxCell id="b9" value="🛡️ ValidateRecord&lt;br&gt;Pydantic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="756" y="100" width="140" height="52" as="geometry"/></mxCell>
        <mxCell id="b10" value="🛡️ PanderaValidate&lt;br&gt;per batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="922" y="100" width="140" height="52" as="geometry"/></mxCell>
        <mxCell id="b11" value="🛡️ EnforceUniqueness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1088" y="100" width="160" height="52" as="geometry"/></mxCell>
        <mxCell id="b12" value="🗄️ landing + DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1274" y="100" width="140" height="52" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6b7280;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="1440" height="250" as="geometry"/></mxCell>
        <mxCell id="t21" value="The seam — everything an engine is allowed to know about the pipeline" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#3c4043;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="210" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="b22" value="--engine = b1_rag | b2_library&lt;br&gt;a STRING: DoFns pickle it, and no package must import every engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#6b7280;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="46" y="246" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="b23" value="⚙️ engines/__init__.py&lt;br&gt;ENGINE_REGISTRY · get_engine(name)&lt;br&gt;each engine registers itself on import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="386" y="246" width="270" height="62" as="geometry"/></mxCell>
        <mxCell id="b24" value="⚙️ GenerationEngine (ABC)&lt;br&gt;setup(model_client, ctx) &amp;nbsp;· &amp;nbsp;generate_batch(n, cfg) &amp;nbsp;· &amp;nbsp;teardown()&lt;br&gt;optional: generate_for_keys(keys, cfg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="696" y="240" width="360" height="74" as="geometry"/></mxCell>
        <mxCell id="b25" value="🧠 ModelClient (Protocol)&lt;br&gt;generate_json(prompt, json_schema, n, temperature, top_p, top_k)&lt;br&gt;engines CALL it · VLLMModelClient owns the server · FakeModelClient in tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1096" y="240" width="360" height="74" as="geometry"/></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b22" target="b23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b23" target="b24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3c4043;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b24" target="b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e29" value="setup() resolves the name → builds ONE engine per process, refcounted (a child fed by a side input builds on its first bundle)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#b44f26;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="388" y="196"/><mxPoint x="768" y="196"/></Array></mxGeometry></mxCell>
        <mxCell id="b30" value="🧳 GenerationContext — what setup() receives: table_schema · reference_rows (the 10k sample) · reference_digest · run id · embedder / model URIs · chunk_store · pool_store · source_value_store · fk_key_pools · fanout · pool_seed_strategy · strict_freetext …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="330" width="700" height="66" as="geometry"/></mxCell>
        <mxCell id="b31" value="🔑 shared-engine key = (engine name, run id, landing table, reference_digest) — N DoFn instances in one process hold ONE engine; the last holder tears it (and its ModelClient) down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="330" width="686" height="66" as="geometry"/></mxCell>
        <mxCell id="b32" value="📜 contract tests both engines must pass: setup is idempotent · batch size respected · schema conformance · same seed ⇒ same rows · teardown releases state · generate_for_keys implemented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f6ee;strokeColor=#1baf7a;strokeWidth=1.3;fontColor=#0d4a34;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="404" width="1410" height="40" as="geometry"/></mxCell>
        <mxCell id="f33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3fbf7;strokeColor=#1baf7a;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="474" width="560" height="410" as="geometry"/></mxCell>
        <mxCell id="t34" value="🔌 engine = b1_rag — statistics per column, the LLM for meaning" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#127a55;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="480" width="530" height="22" as="geometry"/></mxCell>
        <mxCell id="b35" value="&lt;b&gt;setup()&lt;/b&gt; — profile every column · embed rows[:1,024] or read rag_chunks · FAISS IndexFlatIP · 8 seeds per free-text column · pool ladder (≤ 512 novel values) or a freetext_pools hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="512" width="528" height="74" as="geometry"/></mxCell>
        <mxCell id="b36" value="&lt;b&gt;per batch&lt;/b&gt; — NumPy draws from each column&#x27;s own marginal (inverse CDF, empirical frequencies, shapes) · free-text = head literal at its share, else a pool draw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="594" width="528" height="62" as="geometry"/></mxCell>
        <mxCell id="b37" value="&lt;b&gt;reads&lt;/b&gt; &amp;nbsp;🗄️ rag_chunks ✓ (Generate engines) &amp;nbsp;&amp;nbsp;🗄️ freetext_pools ✓ &amp;nbsp;&amp;nbsp;🗄️ source values ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="664" width="528" height="36" as="geometry"/></mxCell>
        <mxCell id="b38" value="&lt;b&gt;only here&lt;/b&gt; — retrieval-picked seeds · persisted pools · constraint router (Tier P pattern / Tier B byte template) · head values · numeric collision scrub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="708" width="528" height="62" as="geometry"/></mxCell>
        <mxCell id="b39" value="&lt;b&gt;gives up&lt;/b&gt; — correlations between ordinary columns: each is sampled on its own (joint sampling of column groups is deferred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="46" y="778" width="528" height="50" as="geometry"/></mxCell>
        <mxCell id="t40" value="GPU: embed + ladder, cold digest only" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5a2f9d;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="46" y="838" width="528" height="22" as="geometry"/></mxCell>
        <mxCell id="f41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3fbf7;strokeColor=#1baf7a;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="910" y="474" width="560" height="410" as="geometry"/></mxCell>
        <mxCell id="t42" value="🔌 engine = b2_library — a fitted tabular model for rows, the LLM as a patch" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#127a55;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="926" y="480" width="530" height="22" as="geometry"/></mxCell>
        <mxCell id="b43" value="&lt;b&gt;setup()&lt;/b&gt; — profile every column · fit sdgx CTGAN (100 epochs) on the constant / numeric / categorical columns of the sample; a fit failure falls back to an empirical per-column backend, with a WARNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="926" y="512" width="528" height="74" as="geometry"/></mxCell>
        <mxCell id="b44" value="&lt;b&gt;per batch&lt;/b&gt; — sample WHOLE ROWS from the fitted model · jitter temporals · patch each free-text column from a lazy 32-value LLM pool (exemplars = the first 32 observed values — no retrieval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="926" y="594" width="528" height="62" as="geometry"/></mxCell>
        <mxCell id="b45" value="&lt;b&gt;reads&lt;/b&gt; &amp;nbsp;🗄️ rag_chunks ✗ &amp;nbsp;&amp;nbsp;🗄️ freetext_pools ✗ &amp;nbsp;&amp;nbsp;🗄️ source values ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1.3;fontColor=#ffffff;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="926" y="664" width="528" height="36" as="geometry"/></mxCell>
        <mxCell id="b46" value="&lt;b&gt;only here&lt;/b&gt; — a JOINT model of the typed columns: row-level co-occurrence survives (for the columns inside the CTGAN frame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.3;fontColor=#202124;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="926" y="708" width="528" height="62" as="geometry"/></mxCell>
        <mxCell id="b47" value="&lt;b&gt;gives up&lt;/b&gt; — persisted pools, retrieval-picked seeds, the constraint router; free-text and temporal columns leave the joint model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=1.3;fontColor=#5f4b00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="926" y="778" width="528" height="50" as="geometry"/></mxCell>
        <mxCell id="t48" value="GPU: the lazy pools only, inside Generate" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5a2f9d;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="926" y="838" width="528" height="22" as="geometry"/></mxCell>
        <mxCell id="f49" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6b7280;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=11;fontColor=#5f6368;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="610" y="474" width="280" height="410" as="geometry"/></mxCell>
        <mxCell id="t50" value="shared by both" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#3c4043;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="626" y="480" width="250" height="22" as="geometry"/></mxCell>
        <mxCell id="b51" value="FK key TUPLES, IPF-weighted (ADR 0031)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="626" y="510" width="248" height="38" as="geometry"/></mxCell>
        <mxCell id="b52" value="parent-driven fan-out + cells (ADR 0036)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1.3;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;fontStyle=0;arcSize=10;" vertex="1" parent="1"><mxGeometry x="626" y="555" width="248" height="38" as="geometry"/></mxCell>
