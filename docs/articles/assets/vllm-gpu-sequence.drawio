<mxfile host="app.diagrams.net">
  <diagram id="VllmGpuSequence" name="VllmGpuSequence">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="1100" as="geometry"/></mxCell>
        <mxCell id="t1" value="Every GPU interaction of a cold pool build — one worker, one column, from DoFn.setup() to teardown()" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="12" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="solid = call · dashed = return · purple bars = the card is busy · orange = Beam DoFn · green = CPU engine work · blue = BigQuery stores · ⚪ names in parentheses are worker-log milestones" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="38" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="p0" value="🔀 BuildFreeTextPools&lt;br&gt;DoFn (pool branch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l3" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="118" as="sourcePoint"/><mxPoint x="110" y="912" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p1" value="⚙️ B1RagEngine&lt;br&gt;(sdfb-core)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="222" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l4" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="118" as="sourcePoint"/><mxPoint x="300" y="912" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p2" value="🧠 BgeEmbedder&lt;br&gt;(bge-small, CUDA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="402" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l5" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="118" as="sourcePoint"/><mxPoint x="480" y="912" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3" value="⚙️ FAISS&lt;br&gt;IndexFlatIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="572" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l6" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="118" as="sourcePoint"/><mxPoint x="650" y="912" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p4" value="🧠 VLLMModelClient&lt;br&gt;(owns the server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="752" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l7" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="118" as="sourcePoint"/><mxPoint x="830" y="912" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5" value="🧠 vLLM API server&lt;br&gt;127.0.0.1:8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="932" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l8" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="118" as="sourcePoint"/><mxPoint x="1010" y="912" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p6" value="🗄️ rag_chunks ·&lt;br&gt;freetext_pools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1122" y="70" width="156" height="48" as="geometry"/></mxCell>
        <mxCell id="l9" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=1.5;endArrow=none;endFill=0;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="118" as="sourcePoint"/><mxPoint x="1200" y="912" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l10" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="150" as="sourcePoint"/><mxPoint x="300" y="150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t11" value="① setup(): build the engine once per process — profile the 10k sample, route every column" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="116" y="120" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="l12" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="190" as="sourcePoint"/><mxPoint x="1200" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t13" value="② freetext_pools probe per column, keyed (reference_digest, model_uri, column, target)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="160" width="888" height="28" as="geometry"/></mxCell>
        <mxCell id="l14" value="" style="edgeStyle=none;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="214" as="sourcePoint"/><mxPoint x="300" y="214" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t15" value="warm: values + attempts + stagnated → nothing below runs, the GPU is never touched (freetext_pools_warm)" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1d5599;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="216" width="888" height="28" as="geometry"/></mxCell>
        <mxCell id="l16" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="265" as="sourcePoint"/><mxPoint x="1200" y="265" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t17" value="③ rag_chunks read for the digest + embedder id — all-or-nothing (b1_chunks_reused)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="235" width="888" height="28" as="geometry"/></mxCell>
        <mxCell id="l18" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="300" as="sourcePoint"/><mxPoint x="480" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t19" value="④ cold only: embed 1,024 row docs + distinct free-text values on CUDA (embedder_device=cuda)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="270" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="c20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="474" y="300" width="12" height="40" as="geometry"/></mxCell>
        <mxCell id="l21" value="" style="edgeStyle=none;html=1;strokeColor=#5a2f9d;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5a2f9d;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="340" as="sourcePoint"/><mxPoint x="300" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t22" value="vectors — then demote_to_cpu(): the card is free BEFORE vLLM sizes its KV budget" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#5a2f9d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="342" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="l23" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="395" as="sourcePoint"/><mxPoint x="650" y="395" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t24" value="⑤ build the exact index · retrieve the top-8 centroid seeds per column (b1_index_built)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="365" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="l25" value="" style="edgeStyle=none;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#127a55;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="419" as="sourcePoint"/><mxPoint x="300" y="419" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t26" value="8 exemplars per column — retrieval runs once per pool build, never per row" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#127a55;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="421" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="l27" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="465" as="sourcePoint"/><mxPoint x="830" y="465" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t28" value="⑥ generate_json(prompt, json_schema, n=4, temperature) — the FIRST LLM call ignites the server lazily" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="435" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="l29" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="505" as="sourcePoint"/><mxPoint x="1010" y="505" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t30" value="⑦ reuse probe GET /v1/models — a healthy sibling server? bind to it (vllm_reuse) · multi: _PortMutex :8001 picks ONE spawner per worker" style="text;html=1;align=right;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="475" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="c31" value="⑧ pull weights GCS → /local-ssd/model (model_pull_done) · dtype guard: bf16 needs SM ≥ 8.0, T4 is 7.5 → --dtype float16 · measure FREE VRAM → --gpu-memory-utilization · clamp --max-model-len to what fits (vllm_max_model_len_clamped), or wait 20 s and re-measure (vllm_unfittable_wait)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1;fontColor=#3f1f7a;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="298" y="540" width="520" height="64" as="geometry"/></mxCell>
        <mxCell id="l32" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="635" as="sourcePoint"/><mxPoint x="1010" y="635" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t33" value="⑨ spawn vllm.entrypoints.openai.api_server · poll /v1/models until 200 (vllm_ready) — our subprocess died but a server answers? adopt it (vllm_spawn_lost_race)" style="text;html=1;align=right;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="605" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="c34" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1004" y="635" width="12" height="215" as="geometry"/></mxCell>
        <mxCell id="l35" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="680" as="sourcePoint"/><mxPoint x="1010" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t36" value="⑩ round 1: POST /v1/chat/completions · response_format=json_schema (a `pattern` joins the grammar) · n=4 · no seed · top_p/top_k pinned per request" style="text;html=1;align=right;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="650" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="c37" value="prefill: the prompt&#x27;s KV blocks are computed and kept (PagedAttention, block-hashed) · decode: 4 sequences under the grammar mask, batched with every other ladder&#x27;s requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1;fontColor=#3f1f7a;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1030" y="696" width="350" height="52" as="geometry"/></mxCell>
        <mxCell id="l38" value="" style="edgeStyle=none;html=1;strokeColor=#5a2f9d;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5a2f9d;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="742" as="sourcePoint"/><mxPoint x="830" y="742" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t39" value="4 JSON arrays × 32 candidate strings" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#5a2f9d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="836" y="744" width="168" height="28" as="geometry"/></mxCell>
        <mxCell id="l40" value="" style="edgeStyle=none;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#127a55;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="770" as="sourcePoint"/><mxPoint x="300" y="770" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t41" value="list[dict] → ⑪ gates on CPU: clamp → format → collapse → novelty (sample ∪ FULL source domain ∪ clause examples) → stagnation" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#127a55;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="740" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="l42" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="810" as="sourcePoint"/><mxPoint x="1010" y="810" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t43" value="⑫ round k: the SAME prompt bytes, only temperature/top_p/top_k change → prefix cache HIT, decode-only; escalate 0.7 → 1.0 → 1.3; bounded rounds" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="780" width="698" height="28" as="geometry"/></mxCell>
        <mxCell id="l44" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="850" as="sourcePoint"/><mxPoint x="1200" y="850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t45" value="⑬ blocking LOAD job into freetext_pools (values, attempts, stagnated) — never streaming inserts, so a DELETE of a tainted digest works at once" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="820" width="888" height="28" as="geometry"/></mxCell>
        <mxCell id="l46" value="" style="edgeStyle=none;html=1;strokeColor=#3c4043;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#3c4043;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="888" as="sourcePoint"/><mxPoint x="830" y="888" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t47" value="⑭ pool_branch_emitted → AwaitFreeTextPools opens · teardown(): refcount −1, the LAST holder terminates the server; multi: kept alive (vllm_server_kept_alive)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=9.5;fontColor=#3c4043;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="116" y="858" width="708" height="28" as="geometry"/></mxCell>
        <mxCell id="c48" value="💬 Warm path = ② hits: the generate stage never opens a CUDA context; if no column needed a pool the launcher already predicted it (llm_route_unused) and the job can run CPU-only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="640" height="54" as="geometry"/></mxCell>
        <mxCell id="c49" value="💬 The KV prefix is a property of the prompt BYTES — static instructions, then column, clause and seeds, identical across rounds. Round 1 pays prefill; every later round is decode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="925" width="640" height="54" as="geometry"/></mxCell>
        <mxCell id="c50" value="💬 Ignition is lazy and serialized: one spawner per process (_SETUP_LOCK), one per worker under multi (_PortMutex); the KV budget is measured from FREE VRAM, never assumed; a lost port race is a reuse, not a failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="988" width="640" height="54" as="geometry"/></mxCell>
        <mxCell id="c51" value="💬 Nothing after ⑬ touches the GPU. Generation, the three lines of defense, the dedup barrier and the BigQuery load are CPU, Dataflow Shuffle and load jobs — the accelerator idles, billed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="988" width="640" height="54" as="geometry"/></mxCell>
        <mxCell id="t52" value="Claim: a cold column costs the GPU one embed, one ignition and a handful of array requests; a warm one costs it nothing — and every step above has a milestone name in the worker log." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="1052" width="1280" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
