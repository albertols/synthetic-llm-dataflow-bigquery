<mxfile host="app.diagrams.net">
  <diagram id="VllmGuardrailsTrack" name="VllmGuardrailsTrack">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="800" as="geometry"/></mxCell>
        <mxCell id="t1" value="Guardrails on the LLM route — two rails bound what can be emitted and what can land; nine stations, in order, and no silent exit" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="12" width="1280" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="&#x27;hallucination&#x27; here is not a wrong fact — it is an OFF-FORMAT value or a COPY of a real one. Every station is deterministic code judged against the reference sample and the source table; there is no LLM-as-judge anywhere on the track." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="38" width="1280" height="22" as="geometry"/></mxCell>
        <mxCell id="l3" value="" style="edgeStyle=none;html=1;strokeColor=#7a3fd1;strokeWidth=6;endArrow=none;endFill=0;fontSize=10;fontColor=#7a3fd1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="200" as="sourcePoint"/><mxPoint x="1360" y="200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c4" value="🛤 decoder-side rail — vLLM structured outputs: the JSON-array schema, plus the column&#x27;s `pattern` when one is declared, is compiled into the decode mask (xgrammar). An off-grammar token cannot be sampled: the model&#x27;s trajectory is constrained before any value exists." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1320" height="60" as="geometry"/></mxCell>
        <mxCell id="l5" value="" style="edgeStyle=none;html=1;strokeColor=#1baf7a;strokeWidth=6;endArrow=none;endFill=0;fontSize=10;fontColor=#1baf7a;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="470" as="sourcePoint"/><mxPoint x="1360" y="470" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c6" value="🛤 pipeline-side rail — the rejection set: observed sample ∪ the column&#x27;s FULL source domain (up to 1M distinct values, Storage Read API) ∪ the clause&#x27;s own examples. A candidate equal to ANY real value is a copy and is dropped, whatever the model &#x27;meant&#x27;; a pool can be short or empty, never a copy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1320" height="60" as="geometry"/></mxCell>
        <mxCell id="l7" value="" style="edgeStyle=none;html=1;strokeColor=#9aa0a6;strokeWidth=3;endArrow=block;endFill=1;fontSize=10;fontColor=#9aa0a6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="335" as="sourcePoint"/><mxPoint x="1360" y="335" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c8" value="🚂 one round&lt;br&gt;= one request:&lt;br&gt;4 completions ×&lt;br&gt;32 candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="290" width="118" height="90" as="geometry"/></mxCell>
        <mxCell id="c9" value="1 · clamp&lt;br&gt;length ceiling of a fixed-width source — candidates are CUT, not rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="184" y="250" width="112" height="78" as="geometry"/></mxCell>
        <mxCell id="c10" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="226" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c11" value="2 · format gate&lt;br&gt;length bucket ∧ charset ∧ observed collapsed mask ∧ no column-name echo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="306" y="250" width="112" height="78" as="geometry"/></mxCell>
        <mxCell id="c12" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="348" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c13" value="3 · format collapse&lt;br&gt;two full rounds with zero in-format values end the ladder early" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="428" y="250" width="112" height="78" as="geometry"/></mxCell>
        <mxCell id="c14" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="470" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c15" value="4 · novelty&lt;br&gt;rejection set + echo count — the station the bottom rail feeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="550" y="250" width="112" height="78" as="geometry"/></mxCell>
        <mxCell id="c16" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="592" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c17" value="5 · stagnation&lt;br&gt;&lt; 4 novel values for 3 rounds after every temperature ran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="672" y="250" width="112" height="78" as="geometry"/></mxCell>
        <mxCell id="c18" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="714" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c19" value="6 · Pydantic&lt;br&gt;per record, load-safety + types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="794" y="250" width="112" height="64" as="geometry"/></mxCell>
        <mxCell id="c20" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="836" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c21" value="7 · Pandera&lt;br&gt;per batch, DataFrame schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="916" y="250" width="112" height="64" as="geometry"/></mxCell>
        <mxCell id="c22" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="958" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c23" value="8 · uniqueness + FK&lt;br&gt;row digest · PK · identity · parent keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1038" y="250" width="112" height="64" as="geometry"/></mxCell>
        <mxCell id="c24" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1080" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c25" value="9 · BLOCKER gate&lt;br&gt;copy_fraction · pk.duplicate · fk.orphan · DLQ ratio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=1;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1160" y="250" width="112" height="64" as="geometry"/></mxCell>
        <mxCell id="c26" value="🚉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1202" y="322" width="28" height="26" as="geometry"/></mxCell>
        <mxCell id="c27" value="🗄️ pool persisted&lt;br&gt;(freetext_pools)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1;fontColor=#ffffff;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="734" y="380" width="108" height="40" as="geometry"/></mxCell>
        <mxCell id="c28" value="🏁 landing table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="300" width="92" height="70" as="geometry"/></mxCell>
        <mxCell id="t29" value="ladder stations (per candidate, per round) — the LLM pool" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#127a55;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="184" y="436" width="600" height="18" as="geometry"/></mxCell>
        <mxCell id="t30" value="row stations (per generated row) — the three lines of defense" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#127a55;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="794" y="436" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="c31" value="⚠️ siding — shape fallback / top-up (freetext_pool_shape_fallback · _topup): the LLM produced nothing usable, or too little — verified-novel values from the column&#x27;s own per-position shapes fill the gap; still short ⇒ freetext_pool_undersized, the run says so" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="430" height="74" as="geometry"/></mxCell>
        <mxCell id="c32" value="⛔ end of the line — strict_freetext (default with a real model): nothing usable at any temperature ⇒ FreeTextEmptyYieldError out of DoFn.setup(); the run FAILS instead of landing exemplar copies. The lax mode exists for the fake client in tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7e9;strokeColor=#d93025;strokeWidth=1;fontColor=#8a1c14;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="485" y="585" width="430" height="74" as="geometry"/></mxCell>
        <mxCell id="c33" value="↩ DLQ siding — every invalid row leaves through a tagged output with its rule_id and full payload; dlq_by_rule feeds the gate and the DLQ table is loaded beside the landing table. Nothing is caught and dropped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=1;fontColor=#5f4a00;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="930" y="585" width="430" height="74" as="geometry"/></mxCell>
        <mxCell id="c34" value="⚪ proof lives in the worker log and in validation_runs: freetext_pool_length_clamped · freetext_pool_format_collapse · freetext_pool_stagnated · freetext_pool_built · dlq_by_rule · copy_fraction — every exit has a name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="672" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="t35" value="Claim: hallucination-free by construction means the grammar bounds what the decoder can emit, the rejection set bounds what can land, and every candidate stops at nine stations in a fixed order — with loud exits only." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="1280" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
