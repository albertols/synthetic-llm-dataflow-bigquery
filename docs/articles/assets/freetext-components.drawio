<mxfile host="app.diagrams.net">
  <diagram id="freetext-components" name="FreetextComponents">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="900" as="geometry"/></mxCell>
        <mxCell id="title" value="Who reads what — the three BigQuery artifacts behind free-text, and the two engines that consume them" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="12" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="sub" value="each artifact has exactly one job — ① rag_chunks seeds prompts, ② freetext_pools skips the ladder on the second run, ③ b2_library reaches the same guardrails without either store; the source domain rejects copies for all three" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="100" y="36" width="1200" height="18" as="geometry"/></mxCell>
        <mxCell id="launcher" value="⚙️ launcher preflight, before the DAG is submitted — parses every llm_prompt_constraint clause and prints the vehicle it drives (pattern sampler / byte template / prompt) · checks routed PK capacity ≥ num_rows · decides warm vs cold: rag chunks exist? pools exist AND pass the taint check (any overlap with the source domain ⇒ delete + rebuild)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1320" height="56" as="geometry"/></mxCell>
        <mxCell id="t-source" value="🗄️ the source table (read-only)&lt;br&gt;reference sample ≤ 10k rows · SELECT DISTINCT domains ≤ 1M values per free-text column · exact Tier-2 distinct counts&lt;br&gt;nothing else is ever read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="t-chunks" value="🗄️ synthetic_rag.rag_chunks&lt;br&gt;row_doc chunks (1,024 rows = the FAISS read prefix) + free_text_col chunks (distinct values, ≤ 1,024 per column)&lt;br&gt;keyed by reference digest + embedder id/version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="t-pools" value="🗄️ synthetic_rag.freetext_pools&lt;br&gt;(reference_digest, model_uri, column, target) → values[], attempts, stagnated&lt;br&gt;invalidated by a new digest OR a new model URI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="t-land" value="🗄️ landing table · DLQ · validation_runs&lt;br&gt;every landed value passed the three lines of defense; every reject carries its rule id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="e-l-src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.11363636363636363;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-source" target="launcher"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-l-src-l" value="taint-overlap SQL · exact stats" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-l-src"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-l-ch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3712121212121212;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-chunks" target="launcher"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-l-ch-l" value="exists?" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-l-ch"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-l-po" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.6287878787878788;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-pools" target="launcher"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-l-po-l" value="exists? delete if tainted" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-l-po"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="dag" value="the Dataflow job — one DAG on GPU workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontColor=#3c4043;fontSize=11;align=center;verticalAlign=top;spacingTop=2;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1320" height="400" as="geometry"/></mxCell>
        <mxCell id="e-r-src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.09090909090909091;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-source" target="dag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-r-src-l" value="rejection sets: pool branch + both engines" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1d5599;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-r-src"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-r-ch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.32575757575757575;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-chunks" target="dag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-r-ch-l" value="① seeds: free_text_col + row_doc&lt;br&gt;read ONCE per pool build, never per row" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1d5599;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-r-ch"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-w-ch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=0.4393939393939394;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dag" target="t-chunks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-w-ch-l" value="① population branch writes&lt;br&gt;(cold RAG only)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#b44f26;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-w-ch"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-r-po" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d5599;strokeWidth=2;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5833333333333334;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-pools" target="dag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-r-po-l" value="② second run: store hit → b1 generate&lt;br&gt;vLLM never ignites" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1d5599;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-r-po"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-w-po" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=0.696969696969697;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dag" target="t-pools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-w-po-l" value="② first run: pool branch writes&lt;br&gt;(blocking LOAD)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#b44f26;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-w-po"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-w-land" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=0.8863636363636364;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dag" target="t-land"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-w-land-l" value="FILE_LOADS after the three lines of defense" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#b44f26;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-w-land"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="pop" value="🔀 population branch (cold RAG only)&lt;br&gt;reference rows → chunks → BgeEmbedder on the GPU, bounded to 2 embedders per job → rag_chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="poolb" value="🔀 pool branch (cold pools only) — BuildFreeTextPoolsDoFn&lt;br&gt;engine setup(): embed or reuse chunks → retrieve seeds → fetch source domains → size targets → run the ladders (≤ 4 in parallel) → blocking LOAD into freetext_pools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="e-pop-pool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pop" target="poolb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-pop-pool-l" value="AwaitRagPopulation" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#b44f26;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-pop-pool"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="vllm" value="🧠 vLLM server — one per worker, spawned by the first LLM call&lt;br&gt;guided JSON, continuous batching, automatic prefix caching on the byte-identical column prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e-pool-vllm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a2f9d;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="poolb" target="vllm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-pool-vllm-l" value="① ladder requests, seeded by ①" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5a2f9d;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-pool-vllm"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="60" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="prov" value="⚪ proof in the worker log&lt;br&gt;b1_chunks_reused · freetext_pools_warm · freetext_pool_store_hit · engine_shared · llm_route_unused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="636" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="gate" value="🔀 AwaitFreeTextPools&lt;br&gt;AsList barrier: generate bundles are not scheduled until the pools are readable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="e-poolb-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="poolb" target="gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="438"/><mxPoint x="380" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="gen-b1" value="🔀 GenerateRecordsDoFn · engine=b1_rag (default)&lt;br&gt;setup(): one engine per process (engine_shared) · pools from the store (freetext_pools_warm) or the process cache · source domains through the same store · no embedding, no CUDA context when warm&lt;br&gt;process(): vectorized draws per batch — Tier P/B samplers, identifier masks, shape expansion, pool draws with replacement, head values, null → empty → value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="e-gate-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.23;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="gen-b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="gen-b2" value="🔀 GenerateRecordsDoFn · engine=b2_library (one flag away)&lt;br&gt;setup(): one sdgx (CTGAN) fit per process, or the empirical backend · NO pool store, NO rag_chunks, NO constraint router (constrained_columns is empty)&lt;br&gt;process(): library sampling for typed columns; FreeTextHook patches free-text per batch — a lazy 32-value LLM pool per column cached in-process, the same escalation ladder, the same source-domain rejection, the same strict_freetext; an empty yield is negative-cached so later batches fail fast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="880" y="420" width="460" height="120" as="geometry"/></mxCell>
        <mxCell id="e-b2-vllm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a2f9d;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-b2" target="vllm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="480"/><mxPoint x="1350" y="656"/><mxPoint x="380" y="656"/><mxPoint x="380" y="575"/></Array></mxGeometry></mxCell>
        <mxCell id="e-b2-vllm-l" value="③ b2_library: lazy per-batch pool calls — same ladder, 32-value pools, no store, no rag_chunks" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5a2f9d;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-b2-vllm"><mxGeometry x="0.05" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="defense" value="🛡️ three lines of defense + uniqueness / FK gates — per-record Pydantic → per-batch Pandera derived from the same contract → BigQuery load rejects; freetext.copy_fraction and memorization gates are BLOCKERs at run level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="940" height="60" as="geometry"/></mxCell>
        <mxCell id="e-b1-def" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-b1" target="defense"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-b2-def" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.73;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-b2" target="defense"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-b2-def-l" value="③ the same guardrails" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#127a55;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-b2-def"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="claim" value="Claim: retrieval is a prompt-seeding device, not a per-row lookup — ① rag_chunks is read once per pool build, ② freetext_pools makes the second run skip the GPU entirely, and ③ b2_library reaches the same guardrails without touching either store." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="100" y="724" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="foot" value="Row and value caps (1,024 rows, 1,024 values per column, 1M-value domain cap, 32-value B.2 pools) are configuration constants; measured warm/cold timings live in the design docs' figure scripts." style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="100" y="766" width="1200" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
