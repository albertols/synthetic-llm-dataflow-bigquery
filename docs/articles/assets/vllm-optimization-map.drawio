<mxfile host="app.diagrams.net">
  <diagram id="VllmOptimizationMap" name="VllmOptimizationMap">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="800" as="geometry"/></mxCell>
        <mxCell id="t1" value="Where each serving optimization sits on the request path — adopted, evaluated, or not (yet) relevant to this workload" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="12" width="1280" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="✅ green outline = adopted or on by default · 🔍 amber = evaluated, not adopted (with the trigger that would reopen it) · ⏭ blue = not explored yet · gray = no pressure here" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="38" width="1280" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value="⚪ prompt bytes&lt;br&gt;static prefix → column → clause → 8 seeds → length hint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="150" height="64" as="geometry"/></mxCell>
        <mxCell id="c4" value="⚙️ tokenizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="210" y="230" width="90" height="64" as="geometry"/></mxCell>
        <mxCell id="c5" value="🧠 prefill&lt;br&gt;block-hash lookup: compute only the un-cached suffix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="190" height="64" as="geometry"/></mxCell>
        <mxCell id="c6" value="🧠 KV cache&lt;br&gt;PagedAttention blocks in HBM (16-token blocks), sized from FREE VRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="530" y="230" width="210" height="64" as="geometry"/></mxCell>
        <mxCell id="c7" value="🧠 decode loop&lt;br&gt;continuous batching · grammar mask (xgrammar) · CUDA graphs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="210" height="64" as="geometry"/></mxCell>
        <mxCell id="c8" value="⚪ detokenize&lt;br&gt;→ JSON array of 32 strings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="990" y="230" width="150" height="64" as="geometry"/></mxCell>
        <mxCell id="c9" value="⚙️ ladder gates&lt;br&gt;(CPU, previous figure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;strokeWidth=1;fontColor=#ffffff;fontSize=9.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1160" y="230" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="weights" value="🧠 weights — fp16 checkpoint on /local-ssd, loaded once per server; the dtype guard refuses bf16-only families on Turing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3fa;strokeColor=#7a3fd1;strokeWidth=1;fontColor=#3f1f7a;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="400" height="44" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#5a2f9d;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#5a2f9d;labelBackgroundColor=#ffffff;dashed=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="weights"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="✅ automatic prefix caching — byte-identical prompts per column: round 1 pays prefill, every later round hits; the hit rate is measured in the engine-stats figure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=2;fontColor=#0e5c40;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="c18" value="✅ PagedAttention — vLLM&#x27;s default block allocator; used, not tuned: with ≤ 4 ladders × n=4 per worker the KV budget stays far from full" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=2;fontColor=#0e5c40;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="✅ structured outputs — response_format=json_schema (+ pattern): the format is enforced in the decoder, prose only steers style" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=2;fontColor=#0e5c40;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="c20" value="✅ VRAM-derived gpu-memory-utilization + max-model-len clamp — ours, in VLLMModelClient: the budget is measured at ignition, never assumed; CUDA graphs on (enforce_eager=false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=2;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="530" y="320" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="c21" value="✅ continuous batching — all Tier-L ladders of a job submit concurrently so the queue stays full; n=4 completions per request are batched server-side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5ec;strokeColor=#1baf7a;strokeWidth=2;fontColor=#0e5c40;fontSize=8.6;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="c22" value="🔍 LMCache — a KV layer that offloads and reuses blocks across engines, restarts and CPU RAM / disk. Not adopted: our hot KV fits HBM (built-in prefix caching captures the reuse), the vLLM ↔ LMCache version matrix must be pinned together, and its pinned CPU-RAM buffer would sit beside the Beam harness. Reopen when many distinct per-table prefixes exceed the card&#x27;s KV budget, or when pools must survive a restart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=2;fontColor=#5f4a00;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="430" height="118" as="geometry"/></mxCell>
        <mxCell id="c23" value="🔍 NVIDIA MPS on Dataflow — shares one CUDA context across SDK processes (meant for RunInference with model_copies &gt; 1). Not adopted: the GPU has ONE tenant per worker, the vLLM server every process reaches over HTTP; the bounded population embed finishes before the spawn. Reopen only with a second model process per card (two vLLM replicas on an L4)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=2;fontColor=#5f4a00;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="490" y="420" width="430" height="118" as="geometry"/></mxCell>
        <mxCell id="c24" value="🔍 TurboQuant / turbovec — an online-quantized ANN index (outside vLLM: the seed retrieval). Not adopted: retrieval is 8 exemplars per column from ≤ 10k vectors, exact IndexFlatIP costs seconds per job, and the M1 contract is bit-exact deterministic top-k; ANN is approximate and its seeding is undocumented. Reopen at the 50k+-vector per-query scale, behind a flag." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;strokeWidth=2;fontColor=#5f4a00;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="940" y="420" width="420" height="118" as="geometry"/></mxCell>
        <mxCell id="c25" value="⏭ AWQ 4-bit checkpoint — frees ~5 GB of KV budget on a T4 and lifts the max-model-len clamp; a config/models.yml decision, not code. Next lever for the T4 tier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1edfa;strokeColor=#2a78d6;strokeWidth=2;fontColor=#12365f;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="320" height="74" as="geometry"/></mxCell>
        <mxCell id="c26" value="⏭ n-gram (prompt-lookup) speculative decoding — no draft model; JSON arrays of formatted strings repeat token runs. Untested; would cut decode time per round on any GPU." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1edfa;strokeColor=#2a78d6;strokeWidth=2;fontColor=#12365f;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="320" height="74" as="geometry"/></mxCell>
        <mxCell id="c27" value="⏭ FP8 KV cache — halves KV bytes per token; needs Ada/Hopper-class (L4 qualifies, T4 does not). Only matters once the KV budget binds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1edfa;strokeColor=#2a78d6;strokeWidth=2;fontColor=#12365f;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="c28" value="⚪ no pressure here — chunked prefill (prompts are short), disaggregated prefill/decode and tensor parallelism (one card per worker), multi-LoRA (one model). Revisit only with a different workload shape." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#3c4043;fontSize=9;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="320" height="74" as="geometry"/></mxCell>
        <mxCell id="t29" value="Claim: what was adopted sits on the prefix and the grammar — the two places this workload repeats itself; what was declined sits where it has no pressure, and each verdict names the trigger that would reverse it." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="1280" height="30" as="geometry"/></mxCell>
        <mxCell id="t30" value="Sources: vLLM docs (prefix caching, structured outputs, speculative decoding), Kwon et al. 2023 (PagedAttention), Dong et al. 2024 (xgrammar), LMCache docs, Zandieh et al. 2025 (TurboQuant), Dataflow NVIDIA MPS docs — linked in the article&#x27;s references." style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#5f6368;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="1280" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
