<mxfile host="app.diagrams.net">
  <diagram id="freetext-flow" name="FreetextResolutionFlow">
    <mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="880" as="geometry"/></mxCell>
        <mxCell id="title" value="Free-text resolution — from a STRING column's DDL to a landed value (engine=b1_rag)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#202124;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="12" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="sub" value="orange = Beam DoFns · green = CPU engine code · purple = the LLM route · blue = BigQuery artifacts · a column takes exactly one exit, and only the purple one ever calls vLLM" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="100" y="34" width="1200" height="18" as="geometry"/></mxCell>
        <mxCell id="ddl" value="📄 DDL + column description JSON&lt;br&gt;llm_prompt_constraint: format · pattern · examples · values · prefix · charset · length · route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="sample" value="🗄️ reference sample ≤ 10k rows&lt;br&gt;null / empty split · distinct · lengths · shapes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="142" width="260" height="46" as="geometry"/></mxCell>
        <mxCell id="profiler" value="⚙️ profiler — profile_columns&lt;br&gt;one ColumnKind per column&lt;br&gt;free-text ⇐ distinct &gt; 50, or unique ≥ 0.9 and mean length ≥ 20&lt;br&gt;(logged in generation_plan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="76" width="200" height="104" as="geometry"/></mxCell>
        <mxCell id="k1" value="CONSTANT&lt;br&gt;copied verbatim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="140" height="56" as="geometry"/></mxCell>
        <mxCell id="k2" value="NUMERIC&lt;br&gt;inverse-CDF over deciles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="752" y="96" width="140" height="56" as="geometry"/></mxCell>
        <mxCell id="k3" value="CATEGORICAL&lt;br&gt;frequency table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="904" y="96" width="140" height="56" as="geometry"/></mxCell>
        <mxCell id="k4" value="TEMPORAL&lt;br&gt;range + sentinels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f3e8;strokeColor=#1baf7a;fontColor=#0e5a3e;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1056" y="96" width="140" height="56" as="geometry"/></mxCell>
        <mxCell id="k5" value="FREE_TEXT&lt;br&gt;the only kind that can reach the LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe3d9;strokeColor=#eb6834;fontColor=#7a2e12;fontSize=10;align=center;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1208" y="90" width="150" height="68" as="geometry"/></mxCell>
        <mxCell id="e-ddl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddl" target="profiler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-sample" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="sample" target="profiler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-k" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="profiler" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="kinds-cap" value="the four typed kinds never call the LLM — their samplers are statistics on CPU (Part 8)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="600" y="156" width="760" height="18" as="geometry"/></mxCell>
        <mxCell id="e-route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b44f26;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddl" target="k5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="64"/><mxPoint x="1283" y="64"/></Array></mxGeometry></mxCell>
        <mxCell id="e-route-l" value="route: &quot;llm&quot; forces a STRING column here" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#b44f26;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-route"><mxGeometry x="0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="router" value="🔀 constraint router (ADR 0028)&lt;br&gt;decided from the parsed clause, before any pool work&lt;br&gt;recorded per column in generation_plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="e-k5-router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="router"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1283" y="190"/><mxPoint x="700" y="190"/></Array></mxGeometry></mxCell>
        <mxCell id="x1" value="expandable shape mix&lt;br&gt;no pool at all — draws come from relaxed per-position shapes&lt;br&gt;(freetext_pool_skipped_expandable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="x2" value="identifier shape&lt;br&gt;mask tables + positional alphabets, novelty vs the FULL source domain&lt;br&gt;(identifier_source_filter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="x3" value="Tier L · LLM pool ladder&lt;br&gt;semantic prose, bounded pool ≤ 512 values, built once, persisted&lt;br&gt;(this article)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;fontColor=#ffffff;fontSize=10;align=center;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="x4" value="Tier B · byte template&lt;br&gt;binary payloads: literal prefix + length-pinned random tail&lt;br&gt;(freetext_pool_byte_template)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="x5" value="Tier P · pattern sampler&lt;br&gt;samplable regex → seeded automaton walk, no LLM, unbounded cardinality&lt;br&gt;(constraint_sampler_active)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="320" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="e-r-x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="x1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="296"/><mxPoint x="160" y="296"/></Array></mxGeometry></mxCell>
        <mxCell id="e-r-x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="x2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="296"/><mxPoint x="420" y="296"/></Array></mxGeometry></mxCell>
        <mxCell id="e-r-x3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="x3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="296"/><mxPoint x="680" y="296"/></Array></mxGeometry></mxCell>
        <mxCell id="e-r-x4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="x4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="296"/><mxPoint x="940" y="296"/></Array></mxGeometry></mxCell>
        <mxCell id="e-r-x5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="x5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="296"/><mxPoint x="1200" y="296"/></Array></mxGeometry></mxCell>
        <mxCell id="exits-cap" value="five exits, one per column — the four green ones are pure CPU samplers; only Tier L pays GPU time, and it pays it once per column per reference digest" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="1280" height="18" as="geometry"/></mxCell>
        <mxCell id="store" value="🗄️ freetext_pools lookup&lt;br&gt;key (reference_digest, model_uri, column, target)&lt;br&gt;taint preflight first: pools overlapping the source domain are deleted and rebuilt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="pooldofn" value="🔀 BuildFreeTextPoolsDoFn&lt;br&gt;pool branch, engine in setup(), one ladder per column, ≤ 4 in parallel&lt;br&gt;(pool_branch_emitted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="ladder" value="🧠 the ladder — vLLM guided-JSON array calls&lt;br&gt;32 values × n=4 per round, temperature 0.7 → 1.0 → 1.3&lt;br&gt;clamp · format gate · collapse · novelty · stagnation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a3fd1;strokeColor=#5a2f9d;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="440" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="persist" value="🔀 persist + barrier&lt;br&gt;blocking LOAD into freetext_pools, then AwaitFreeTextPools holds Generate back&lt;br&gt;(freetext_pool_store_written)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="440" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="e-miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="store" target="pooldofn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-miss-l" value="miss" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5f6368;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-miss"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-dofn-ladder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pooldofn" target="ladder"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-ladder-persist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ladder" target="persist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="seeds" value="🗄️ rag_chunks — prompt seeds only&lt;br&gt;8 free_text_col value exemplars per column; row_doc centroid exemplars as fallback (b1_chunks_reused)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="540" width="290" height="56" as="geometry"/></mxCell>
        <mxCell id="domain" value="🗄️ source domain — the rejection set&lt;br&gt;SELECT DISTINCT ≤ 1M values per column (ADR 0023): a generated value that exists in the source is dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="540" width="250" height="56" as="geometry"/></mxCell>
        <mxCell id="failover" value="⚙️ failovers, all loud&lt;br&gt;shape fallback · shape top-up · undersized · binary template&lt;br&gt;strict_freetext ⇒ FreeTextEmptyYieldError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#127a55;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="540" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="e-seeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2a78d6;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="seeds" target="ladder"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-domain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2a78d6;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="domain" target="ladder"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="568"/><mxPoint x="600" y="496"/></Array></mxGeometry></mxCell>
        <mxCell id="e-failover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ladder" target="failover"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="496"/><mxPoint x="930" y="568"/></Array></mxGeometry></mxCell>
        <mxCell id="gen" value="🔀 GenerateRecordsDoFn — every column's sampler runs vectorized on CPU, per batch&lt;br&gt;Tier P/B samplers · identifier masks · shape expansion · pool draws with replacement (dominant head values re-emitted at their observed share) · one uniform draw decides null → empty → value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#b44f26;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1280" height="66" as="geometry"/></mxCell>
        <mxCell id="e-x1-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.984375;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="x1" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="412"/><mxPoint x="1340" y="412"/><mxPoint x="1340" y="620"/></Array></mxGeometry></mxCell>
        <mxCell id="e-x2-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.984375;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="x2" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="412"/><mxPoint x="1340" y="412"/><mxPoint x="1340" y="620"/></Array></mxGeometry></mxCell>
        <mxCell id="e-x4-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.984375;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="x4" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="412"/><mxPoint x="1340" y="412"/><mxPoint x="1340" y="620"/></Array></mxGeometry></mxCell>
        <mxCell id="e-x5-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#127a55;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.984375;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="x5" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="412"/><mxPoint x="1340" y="412"/><mxPoint x="1340" y="620"/></Array></mxGeometry></mxCell>
        <mxCell id="e-persist-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a2f9d;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.90625;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="persist" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="475"/></Array></mxGeometry></mxCell>
        <mxCell id="e-persist-gen-l" value="pools readable" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5a2f9d;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-persist-gen"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-hit-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a2f9d;strokeWidth=2;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.08984375;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="store" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-hit-gen-l" value="hit (warm) → freetext_pools_warm" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5a2f9d;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-hit-gen"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="land" value="🛡️ three lines of defense + uniqueness / FK gates  →  🗄️ landing table · DLQ · validation_runs&lt;br&gt;freetext.copy_fraction is a BLOCKER: a pool value found in the source fails the run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#1d5599;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="736" width="700" height="56" as="geometry"/></mxCell>
        <mxCell id="e-gen-land" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6368;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="land"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="claim" value="Claim: a STRING column takes one of five exits before the LLM is involved, and the LLM exit is a bounded pool built once per column and reference digest — never a call per row." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3c4043;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="100" y="812" width="1200" height="40" as="geometry"/></mxCell>
