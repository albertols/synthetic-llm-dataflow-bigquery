        <mxCell id="ddl" value="📄 DDL + reference sample&lt;br&gt;per-column profile (stats, shapes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;fontColor=#ffffff;strokeColor=#1d5599;fontSize=11;" vertex="1" parent="1">
