          <mxGeometry x="300" y="262" width="190" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="constant" value="⚙️ Constant → copied verbatim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=#127a55;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="60" width="330" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cat" value="🎲 Categorical → empirical frequency table&lt;br&gt;never invents unseen categories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=#127a55;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="112" width="330" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="num" value="🎲 Numeric → inverse-CDF over decile vectors&lt;br&gt;draws land where the source is dense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=#127a55;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="172" width="330" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="temp" value="🎲 Temporal → epoch-axis inverse-CDF&lt;br&gt;sentinel years preserved · now−10y floor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=#127a55;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="232" width="330" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="ident" value="🛡️ Identifier-shaped → mask tables + positional alphabets&lt;br&gt;deterministic, novelty-checked vs FULL source domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=#127a55;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="292" width="330" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="pk" value="🔑 PK / identity → blake2b(run_id, batch, row)&lt;br&gt;never from reference data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=#127a55;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="352" width="330" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="fk" value="🔗 FK → joint parent-key tuples, IPF weights&lt;br&gt;referential integrity by construction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=#127a55;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
