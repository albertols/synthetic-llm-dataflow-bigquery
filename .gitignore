# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# uv / virtualenvs
.venv/
.venv-*/
uv.lock.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# direnv — real .envrc is per-machine and may contain proxy URLs / cert paths
# (template is .envrc.example, committed)
.envrc
.direnv/

# Local pipeline artifacts
output/
temp/
*.log
local-ssd/
.beam/

# NEVER commit model weights — they live in gs://{project}-models/
models/
*.safetensors
*.gguf
*.bin
*.pt

# GCP / credentials — should never reach the repo
*.json.key
service-account-*.json
.gcloud/
application_default_credentials.json

.github/workflows/*
# The wildcard keeps the enterprise build/deploy workflows (ADR 0008: JFrog,
# WIF, ARC runners) out of this personal repo — but the laptop CI gate is
# infra-free and MUST be tracked, or no PR check ever runs.
!.github/workflows/ci.yml
!.github/workflows/release_tag_report.yaml
docs/superpowers/specs
public_cloud/deploy/gcp/journal/*.jsonl
public_cloud/deploy/gcp/journal/image_tag
integration_tests/
